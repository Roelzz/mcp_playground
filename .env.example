LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=2009
DB_PATH=playground.db
PUBLIC_BASE_URL=http://localhost:2009

# Leave blank to auto-generate an admin user and API key on first boot.
# The generated credentials are printed to the log once.
BOOTSTRAP_USER=
BOOTSTRAP_PASSWORD=

# Set to 1 when serving over plain http on a LAN so session cookies still work.
INSECURE_COOKIES=0
