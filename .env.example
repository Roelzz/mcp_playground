LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=2009
DB_PATH=playground.db

# SQLite journal mode. WAL locally; must be DELETE on Azure Files/SMB
# (WAL needs mmap-backed shared memory, which SMB does not provide).
# Allowed: WAL, DELETE, TRUNCATE, PERSIST, MEMORY
SQLITE_JOURNAL_MODE=WAL

# SQLite VFS. Empty locally. Set to unix-dotfile on Azure Files/SMB, where POSIX
# byte-range locks are unreliable and SQLite otherwise fails with "database is locked".
# Allowed: unix, unix-dotfile, unix-excl, unix-none
SQLITE_VFS=

# SQLite busy timeout in milliseconds. Raise to 15000 on network storage.
SQLITE_BUSY_TIMEOUT=5000

PUBLIC_BASE_URL=http://localhost:2009

# Leave blank to auto-generate an admin user and API key on first boot.
# The generated credentials are printed to the log once.
BOOTSTRAP_USER=
BOOTSTRAP_PASSWORD=

# Set to 1 when serving over plain http on a LAN so session cookies still work.
INSECURE_COOKIES=0

# How long a browser session stays valid before re-login is required.
SESSION_TTL_HOURS=12

# Set to 1 to bypass all authentication. Local development only -- never in Azure.
AUTH_DISABLED=0

# SSRF guard for proxy-mode LLM upstreams.
# NEVER set ALLOW_PRIVATE_UPSTREAM=1 in Azure or production. It permits private,
# loopback and link-local upstream addresses for local testing only.
ALLOW_PRIVATE_UPSTREAM=0

# Optional comma-separated list of exact hosts or domain suffixes allowed for
# proxy-mode LLM upstreams. Empty means any host is allowed after IP safety checks.
# Example: api.openai.com,openai.azure.com
UPSTREAM_ALLOWLIST=

# Throttling on /mcp, /v1, /rest and /api. Callers are identified by API key,
# then session cookie, then client IP. Set either limit to 0 to disable it.
#
# Budget for a caller identified by an API key or session cookie.
RATE_LIMIT_PER_MINUTE=300
#
# Budget for a caller identified only by IP. Much higher on purpose: servers with
# auth_mode=none are reached through Copilot Studio, so an entire cohort arrives
# from a handful of shared Microsoft egress addresses and lands in one bucket.
RATE_LIMIT_PER_MINUTE_ANON=6000
